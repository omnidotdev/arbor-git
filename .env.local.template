# arbor-git environment configuration

# Logging
RUST_LOG=arbor_git=debug,tower_http=debug

# Server ports
GRPC_PORT=50051
HTTP_PORT=8080

# Storage configuration
STORAGE_PATH=./data/repositories
GIT_DEFAULT_BRANCH=main
# Maximum repository size in bytes (default 1 GiB)
GIT_MAX_REPO_SIZE=1073741824
