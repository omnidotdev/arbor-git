# arbor-git environment configuration

# Logging
RUST_LOG=arbor_git=debug,tower_http=debug

# Server ports
GRPC_PORT=50051
HTTP_PORT=8080

# Storage configuration
STORAGE_PATH=./data/repositories
DEFAULT_BRANCH=main

# Database (for repository metadata)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arbor_git
